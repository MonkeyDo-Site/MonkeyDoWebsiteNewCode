# Template only; values are not loaded automatically by Django.
# Copy into protected local/server configuration, never commit real values.
APP_ENV=development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Required for staging; leave POSTGRES_DB unset for the SQLite local fallback.
POSTGRES_DB=
POSTGRES_USER=monkeydo
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Reserved for later integration; NOT consumed by this foundation.
# Staging must use sandbox credentials only. Do not install live keys here.
BANQUEST_API_SOURCE_KEY=
BANQUEST_API_PIN=
BANQUEST_TOKENIZATION_PUBLIC_KEY=
BANQUEST_WEBHOOK_KEY=
