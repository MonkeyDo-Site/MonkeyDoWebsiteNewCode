# Separate root:root 0600 /etc/monkeydo/backup.env; systemd supplies it only to the
# dedicated backup UID/DB role. No payment, waiver, account-mail or recovery private key.
APP_ENV=staging
MONKEYDO_DESIGN_ONLY=0
DJANGO_SECRET_KEY=GENERATE_DISTINCT_COMMAND_ONLY_SECRET_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=staging.monkeydoplay.com
POSTGRES_DB=monkeydo_functional
POSTGRES_USER=monkeydo-functional-backup
POSTGRES_HOST=/var/run/postgresql
MONKEYDO_BACKUPS=1
MONKEYDO_BOOKING_EMAIL=1
MONKEYDO_R2_ACCOUNT_ID=ENTER_PRIVATELY
R2_BACKUP_BUCKET=monkeydo-staging-backups
R2_BACKUP_ACCESS_KEY=ENTER_BACKUP_BUCKET_ONLY_KEY_PRIVATELY
R2_BACKUP_SECRET_KEY=ENTER_PRIVATELY
MONKEYDO_BACKUP_PUBLIC_CERTIFICATE=/etc/monkeydo/backup-public.pem
