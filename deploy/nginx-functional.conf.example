# Add alongside existing design-review config. DNS-only A record, then TLS with certbot.
# Do not replace default_server, current staging host, mail or root-domain records.
server {
    listen 80;
    server_name testing.monkeydoplay.com;
    server_tokens off;
    access_log off;
    client_max_body_size 1m;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Cache-Control "private, no-store" always;
    location / {
        proxy_pass http://unix:/run/monkeydo-functional/gunicorn.sock;
        proxy_set_header Host testing.monkeydoplay.com;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Connection "";
        proxy_read_timeout 65s;
    }
}
