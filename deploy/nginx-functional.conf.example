# CUTOVER EXAMPLE: replaces the existing staging vhost, never adds a duplicate.
# Preserve the current nginx file/certificate paths for recovery. Run nginx -t
# before reload. No DNS or certificate issuance is needed for the existing URL.
server {
    listen 80;
    server_name staging.monkeydoplay.com;
    return 301 https://staging.monkeydoplay.com$request_uri;
}
server {
    listen 443 ssl;
    server_name staging.monkeydoplay.com;
    # Verify these match the existing certificate paths before installation.
    ssl_certificate /etc/letsencrypt/live/staging.monkeydoplay.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.monkeydoplay.com/privkey.pem;
    server_tokens off;
    access_log off;
    client_max_body_size 1m;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Cache-Control "private, no-store" always;
    location / {
        proxy_pass http://unix:/run/monkeydo-functional/gunicorn.sock;
        proxy_set_header Host staging.monkeydoplay.com;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Connection "";
        proxy_read_timeout 65s;
    }
}
