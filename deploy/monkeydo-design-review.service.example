# Pinned read-only V1 release. Install only during the authorized host setup.
[Unit]
Description=MonkeyDo private frozen design review V1
After=network.target postgresql.service

[Service]
Type=simple
User=monkeydo
Group=www-data
WorkingDirectory=/srv/monkeydo/staging/current
EnvironmentFile=/etc/monkeydo/staging.env
Environment=APP_ENV=staging
Environment=MONKEYDO_DESIGN_ONLY=1
RuntimeDirectory=monkeydo-staging
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/srv/monkeydo/staging/venv/bin/gunicorn config.wsgi:application --workers 2 --umask 7 --bind unix:/run/monkeydo-staging/gunicorn.sock --timeout 60
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/monkeydo-staging

[Install]
WantedBy=multi-user.target
