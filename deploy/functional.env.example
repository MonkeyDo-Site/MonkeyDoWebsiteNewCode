# Example ONLY; put actual private values in /etc/monkeydo/functional.env on the server.
# root:monkeydo-functional 0640; never commit the filled-in file.
APP_ENV=staging
MONKEYDO_DESIGN_ONLY=0
MONKEYDO_CUSTOMER_TEST_BOOKING=1
DJANGO_SECRET_KEY=GENERATE_A_NEW_DISTINCT_SECRET_OF_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=staging.monkeydoplay.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.monkeydoplay.com
DJANGO_TRUST_PROXY=1
MONKEYDO_TRUST_LOCAL_CLIENT_IP=1
POSTGRES_DB=monkeydo_functional
POSTGRES_USER=monkeydo-functional
POSTGRES_HOST=/var/run/postgresql
MONKEYDO_EMAIL_TRANSPORT=resend
RESEND_API_KEY=ENTER_PRIVATELY_ON_SERVER
MONKEYDO_TEST_EMAIL_RECIPIENTS=owner@example.invalid,staff@example.invalid

# New booking stage: leave OFF until private configuration/acceptance is complete.
MONKEYDO_PAYMENT_SANDBOX=0
MONKEYDO_WAIVERS=0
MONKEYDO_BOOKING_EMAIL=0
MONKEYDO_BOOKING_COMPLETION=0
MONKEYDO_BACKUPS=0
# BANQUEST_API_SOURCE_KEY=ENTER_PRIVATELY
# BANQUEST_API_PIN=ENTER_PRIVATELY
# BANQUEST_TOKENIZATION_PUBLIC_KEY=pk_ENTER_SANDBOX_PUBLIC_KEY_PRIVATELY
# BANQUEST_WEBHOOK_KEY=ENTER_PRIVATELY
# RESEND_WEBHOOK_SECRET=whsec_ENTER_PRIVATELY
# MONKEYDO_R2_ACCOUNT_ID=ENTER_PRIVATELY
# MONKEYDO_R2_WAIVER_BUCKET=monkeydo-staging-waivers
# MONKEYDO_R2_WAIVER_ACCESS_KEY=ENTER_PRIVATELY
# MONKEYDO_R2_WAIVER_SECRET_KEY=ENTER_PRIVATELY
# R2_BACKUP_BUCKET=monkeydo-staging-backups
# R2_BACKUP_READ_ACCESS_KEY=ENTER_GET_ONLY_KEY_PRIVATELY
# R2_BACKUP_READ_SECRET_KEY=ENTER_PRIVATELY
MONKEYDO_RECOVERY_HOLD=0
