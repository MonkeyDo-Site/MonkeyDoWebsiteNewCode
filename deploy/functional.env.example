# Example ONLY; put actual private values in /etc/monkeydo/functional.env on the server.
# root:monkeydo-functional 0640; never commit the filled-in file.
APP_ENV=staging
MONKEYDO_DESIGN_ONLY=0
MONKEYDO_CUSTOMER_TEST_BOOKING=1
DJANGO_SECRET_KEY=GENERATE_A_NEW_DISTINCT_SECRET_OF_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=testing.monkeydoplay.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://testing.monkeydoplay.com
DJANGO_TRUST_PROXY=1
MONKEYDO_TRUST_LOCAL_CLIENT_IP=1
POSTGRES_DB=monkeydo_functional
POSTGRES_USER=monkeydo-functional
POSTGRES_HOST=/var/run/postgresql
MONKEYDO_EMAIL_TRANSPORT=resend
RESEND_API_KEY=ENTER_PRIVATELY_ON_SERVER
MONKEYDO_TEST_EMAIL_RECIPIENTS=owner@example.invalid,staff@example.invalid
